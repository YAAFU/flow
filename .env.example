# Server-only. Never expose this key in browser code.
ANTHROPIC_API_KEY=

# Optional Supabase Auth and cloud-sync configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional public MapLibre style URL. This is client-visible configuration, not
# a place for an API secret. Leave blank to use Flow's CARTO Positron default.
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional Google Calendar OAuth. Keep the secret server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
